# Copy to .env and fill in. .env is gitignored; this file is committed.

# The provider seam. Switch Groq <-> Gemini <-> Ollama by changing ONLY this.
AI_PROVIDER=groq          # groq | gemini | ollama | mock

# Optional model override (each provider has a sensible default).
# AI_MODEL=llama-3.1-8b-instant

# Keys — set the one matching AI_PROVIDER. Get a free Groq key at
# https://console.groq.com (no card). Gemini: https://aistudio.google.com.
GROQ_API_KEY=your_groq_key_here
# GEMINI_API_KEY=your_gemini_key_here
# OLLAMA_HOST=http://localhost:11434
